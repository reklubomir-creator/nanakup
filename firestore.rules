rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function pathFor(id) { return /databases/$(database)/documents/lists/$(id); }
    function inviteFor(code) { return /databases/$(database)/documents/invites/$(code); }
    function shortInvite(code) { return code.matches('[A-Z0-9]{4}'); }
    function legacyInvite(code) { return code.matches('[23456789A-HJ-NP-Z]{12}'); }
    function inviteActive(code, data) {
      return legacyInvite(code) || (shortInvite(code)
        && data.createdAt is timestamp && request.time < data.createdAt + duration.value(10,'m'));
    }
    function member(data) { return signed() && me() in data.memberIds; }
    function owner(data) { return signed() && data.owner == me(); }
    function short(s,n) { return s is string && s.size() <= n; }
    function name(s) { return short(s,120) && s.size() > 0; }
    match /lists/{id} {
      allow list: if member(resource.data);
      allow get: if (signed() && id == 'default-' + me()) || member(resource.data);
      allow create: if signed() && (!id.matches('default-.*') || id == 'default-' + me())
        && request.resource.data.keys().hasOnly(['name','owner','memberIds','names','categories','manual','hideEmpty','archived','invite'])
        && owner(request.resource.data) && request.resource.data.memberIds == [me()]
        && request.resource.data.names.keys().hasOnly([me()]) && name(request.resource.data.names[me()])
        && request.resource.data.invite == '' && request.resource.data.archived == false
        && name(request.resource.data.name) && validDisplay(request.resource.data);
      function validDisplay(data) {
        return data.categories is list && data.categories.size() <= 50 && data.manual is bool && data.hideEmpty is bool;
      }
      function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function onlyAddSelf(after, before) {
        return after.memberIds == before.memberIds.concat([me()]) && !(me() in before.memberIds)
          && after.names.diff(before.names).affectedKeys().hasOnly([me()]) && name(after.names[me()]);
      }
      function joins(after,before) {
        return signed() && !before.archived && changes().hasOnly(['memberIds','names','joinCode'])
          && after.joinCode is string && after.joinCode == before.invite
          && after.joinCode != '' && exists(inviteFor(after.joinCode))
          && get(inviteFor(after.joinCode)).data.listId == id
          && inviteActive(after.joinCode,get(inviteFor(after.joinCode)).data)
          && onlyAddSelf(after,before);
      }
      function leaves(after,before) {
        return member(before) && !owner(before) && changes().hasOnly(['memberIds'])
          && after.memberIds == before.memberIds.removeAll([me()]);
      }
      function renamesSelf(after,before) {
        return member(before) && !before.archived && changes().hasOnly(['names'])
          && after.names.diff(before.names).affectedKeys().hasOnly([me()]) && name(after.names[me()]);
      }
      function ownerEdit(after,before) {
        return owner(before) && !before.archived
          && changes().hasOnly(['name','memberIds','categories','manual','hideEmpty','archived','invite'])
          && after.memberIds is list && me() in after.memberIds && before.memberIds.hasAll(after.memberIds)
          && name(after.name) && validDisplay(after) && after.archived is bool && short(after.invite,12)
          && (!changes().hasAny(['invite']) || (
              (before.invite == '' || !existsAfter(inviteFor(before.invite))) &&
              (after.invite == '' || getAfter(inviteFor(after.invite)).data.listId == id)
          ));
      }
      function memberEditsInvite(after,before) {
        return member(before) && !before.archived && changes().hasOnly(['invite'])
          && short(after.invite,12)
          && (before.invite == '' || !existsAfter(inviteFor(before.invite)))
          && (after.invite == '' || getAfter(inviteFor(after.invite)).data.listId == id);
      }
      function sharedContact(sourceId,uid,displayName) {
        let source = get(pathFor(sourceId)).data;
        return !source.archived && member(source) && uid in source.memberIds
          && displayName == source.names[uid];
      }
      function memberAddsSharedContact(after,before) {
        let grant = after.get('memberGrant',{});
        let uid = grant.get('uid','');
        let sourceId = grant.get('sourceId','');
        return member(before) && !before.archived
          && changes().hasOnly(['memberIds','names','memberGrant'])
          && grant.keys().hasOnly(['uid','sourceId'])
          && name(uid) && name(sourceId) && sourceId != id && !(uid in before.memberIds)
          && after.memberIds == before.memberIds.concat([uid])
          && after.names.diff(before.names).affectedKeys().hasOnly([uid])
          && name(after.names[uid]) && sharedContact(sourceId,uid,after.names[uid]);
      }
      allow update: if ownerEdit(request.resource.data,resource.data) || joins(request.resource.data,resource.data)
        || memberEditsInvite(request.resource.data,resource.data)
        || memberAddsSharedContact(request.resource.data,resource.data) || leaves(request.resource.data,resource.data) || renamesSelf(request.resource.data,resource.data);
      function active() {
        return signed() && !get(pathFor(id)).data.archived && member(get(pathFor(id)).data);
      }
      match /items/{item} {
        function valid(data) {
          return data.keys().hasOnly(['name','qty','category','done','rank','author'])
            && name(data.name) && short(data.qty,80) && short(data.category,80)
            && data.done is bool && data.rank is number;
        }
        allow read, delete: if active();
        allow create: if active() && valid(request.resource.data) && request.resource.data.author == me();
        allow update: if active() && valid(request.resource.data) && request.resource.data.author == resource.data.author;
      }
      match /pushActors/{actor} {
        function validActor(data) {
          return signed() && data.uid == me() && data.pendingAt == request.time
            && short(data.deviceId,36)
            && (data.deviceId == '' || data.deviceId.matches('[0-9a-f-]{36}'));
        }
        function validMembership(targets) {
          let before = get(pathFor(id)).data;
          let after = getAfter(pathFor(id)).data;
          let prior = before.memberIds.toSet();
          let current = after.memberIds.toSet();
          let affected = prior.difference(current).union(current.difference(prior));
          return targets is list && targets.size() > 0
            && (member(before) || member(after))
            && ((before.archived != after.archived && targets.toSet() == prior.union(current))
              || (before.archived == after.archived && targets.toSet() == affected));
        }
        function validDirectAddition(data) {
          let before = get(pathFor(id)).data;
          let after = getAfter(pathFor(id)).data;
          return member(before) && !before.archived && !after.archived
            && data.affected == [data.added] && data.added == after.get('memberGrant',{}).get('uid','')
            && after.memberIds == before.memberIds.concat([data.added]);
        }
        allow create, update: if active() && actor == me()
          && request.resource.data.keys().hasOnly(['pendingAt'])
          && request.resource.data.pendingAt == request.time;
        allow create, update: if active() && validActor(request.resource.data)
          && actor == me() + ':' + request.resource.data.deviceId
          && request.resource.data.keys().hasOnly(['uid','deviceId','pendingAt']);
        allow create: if validActor(request.resource.data)
          && request.resource.data.keys().hasOnly(['uid','deviceId','pendingAt','affected','added'])
          && validMembership(request.resource.data.affected)
          && (!('added' in request.resource.data) || validDirectAddition(request.resource.data));
      }
      match /history/{item} {
        allow read: if active();
        allow create, update: if active()
          && request.resource.data.keys().hasOnly(['name','qty','category','count'])
          && name(request.resource.data.name) && short(request.resource.data.qty,80)
          && short(request.resource.data.category,80)
          && (!('count' in request.resource.data) || request.resource.data.count is int);
      }
    }
    match /pushDevices/{id} {
      function validDevice(data) {
        return data.keys().hasOnly(['uid','token','muted'])
          && data.uid == me() && name(data.uid)
          && short(data.token,4096) && data.token.size() > 0
          && data.muted is list && data.muted.size() <= 100;
      }
      allow get: if signed() && resource.data.uid == me();
      allow create: if signed() && validDevice(request.resource.data);
      allow update: if signed() && resource.data.uid == me() && validDevice(request.resource.data);
      allow delete: if signed() && resource.data.uid == me();
    }
    function mayShare(id) {
      let list = get(pathFor(id)).data;
      return member(list) && !list.archived;
    }
    match /invites/{code} {
      allow get: if signed() && (resource == null || inviteActive(code,resource.data));
      allow create: if signed() && (
          (legacyInvite(code) && request.resource.data.keys().hasOnly(['listId'])) ||
          (shortInvite(code) && request.resource.data.keys().hasOnly(['listId','createdAt'])
            && request.resource.data.createdAt == request.time)
        )
        && mayShare(request.resource.data.listId)
        && getAfter(pathFor(request.resource.data.listId)).data.invite == code;
      allow delete: if mayShare(resource.data.listId)
        && getAfter(pathFor(resource.data.listId)).data.invite != code;
    }
  }
}
